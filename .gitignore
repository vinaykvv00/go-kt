# Build outputs at any depth (root and nested projects).
build/
dist/
out/
bin/
obj/

# Go and native compiled artifacts.
*.exe
*.exe~
*.dll
*.so
*.dylib
*.a
*.o
*.test
*.prof
coverage/
coverage.out
coverage.txt

# Go binaries have no required extension: list their output paths explicitly,
# or use `go build -o bin/app .` from the package directory.
/web/main

# Web dependencies, caches, and generated framework output.
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz
.pnp.*
.next/
.nuxt/
.output/
.svelte-kit/
.astro/
.angular/cache/
.parcel-cache/
.turbo/
.vite/
*.tsbuildinfo
.eslintcache
.stylelintcache
.nyc_output/
playwright-report/
test-results/

# Python learning projects: local environments and generated caches.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
*.egg-info/

# Local secrets; keep sanitized example and template files trackable.
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template
!.env.*.template

# Logs, temporary files, and caches.
*.log
*.log.*
tmp/
temp/
.cache/
*.tmp
*.swp
*.swo
*~

# Machine-specific editor and operating-system files.
.idea/
.vscode/*.local.json
*.code-workspace
.DS_Store
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Keep source, go.mod, go.sum, go.work, go.work.sum, web lockfiles,
# migrations, Docker files, and shared editor settings under version control.
# Do not ignore vendor/ by default: vendoring may be intentional.